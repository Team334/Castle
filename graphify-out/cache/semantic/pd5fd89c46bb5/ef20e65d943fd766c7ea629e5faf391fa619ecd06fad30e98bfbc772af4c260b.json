{"nodes": [{"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design", "label": "Match-day fixes design (Maneuver batch 1)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_maneuver", "label": "Maneuver", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "frc-maneuver.com, the scouting app the team compared Castle with; 36 gaps found."}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_maneuver_feature_batches", "label": "Maneuver feature batches", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "36 gaps split into 4 batches: match-day fixes, next-season features, 2026 field features, offline capture and transfer. Batch 1 first because record identity underpins 8 later features."}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_record_identity", "label": "Record identity", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store TBA event_key and match_key; display names repeat every year and would collide across seasons. Missing keys never reject a record."}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_same_team_duplicate_block", "label": "Same-team duplicate block", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User chose block over replace (Maneuver's behaviour, silently loses the first entry) and over keep-both; server check rather than bypassable client check or a unique index that can't express 'same scouting team'. Known check-then-insert race accepted."}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_draft_recovery", "label": "Draft recovery", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "localStorage drafts keyed per user (castle:scout-drafts:<user>) as a map so shared tablets never offer another user's draft and new entries never overwrite older unsaved ones; cleared only on confirmed ?saved=<id>."}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_draft_id", "label": "_draft_id", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_next_match_flow", "label": "Next-match flow", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redirect after save carries validated event, after, station and saved params so the add form reopens on the next match; chosen over device storage because the server can validate it."}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_exclude_from_stats", "label": "Exclude from stats", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An excluded flag drops bad matches from every average but keeps the record and its notes; deleting loses notes, a separate collection is needless. Excluded records don't block re-scouting."}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_the_blue_alliance_tba", "label": "The Blue Alliance (TBA)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_access_match_scope", "label": "access_match scope", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Castle is multi-team and each team sees only its own records; records from two teams must never block each other."}], "edges": [{"source": "docs_superpowers_specs_2026_11_11_match_day_fixes_design", "target": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_maneuver_feature_batches", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_11_match_day_fixes_design", "target": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_record_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-11-match-day-fixes-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_11_match_day_fixes_design", "target": "docs_superpowers_specs_2026_11_11_match_day_fixes_design_same_team_duplicate_block", "relation": "references", "confidence": "EXTRACTED"