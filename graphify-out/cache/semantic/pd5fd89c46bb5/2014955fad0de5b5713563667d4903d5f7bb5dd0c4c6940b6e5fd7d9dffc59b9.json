{"nodes": [{"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design", "label": "Castle redesign design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_team_334_techknights", "label": "Team 334 TechKnights", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_banner_light_theme", "label": "Banner light theme", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Team 334 blue top bar with black page titles; the team found white text on blue too bright."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_night_watch_dark_theme", "label": "Night Watch dark theme", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_approach_c_rebuild_every_page_on_the_kit", "label": "Approach C: rebuild every page on the kit", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over remapping colors (A) or renaming by role (B); the kit can't load on Tailwind pages (grid collapse, class collisions, system.js takeover), so only the landing page loads kit files and app pages port its rules into Tailwind."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_taste_skill_website_design_kit", "label": "taste-skill website-design kit", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_hook_contract", "label": "Hook contract", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appendix listing every id, class and DOM hook each page must keep so JS, CSV export and canvas keep working."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_palette_tokens", "label": "Palette tokens", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role-named Tailwind colors backed by CSS variables (canvas, surface, ink, brand...) with every text pair at least 4.5:1; dark button blue darkened to #2a6fcf to pass AA."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_type_system", "label": "Type system", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Display font renamed castle-display.otf because the service worker's url.includes() breaks on spaces; oxanium-vrb.ttf keeps its name because team_utils.py opens it by path."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_savebar_component", "label": ".savebar component", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sticky full-width save bar; forms keep native POST and 'Saved' is the toast after redirect."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_offline_save_guard", "label": "Offline save guard", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If navigator.onLine is false on Save, block submit and keep every value; previously an offline save showed a browser error and lost the entry on Back."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_table_cards_phone_view", "label": ".table-cards phone view", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L160", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tables become cards via CSS on the same <table> markup so row.cells, nth-child selectors and the CSV export keep working."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_counter_component", "label": ".counter component", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L146", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps every step button (no step removed) because dropping bulk steps would change how scouters count."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_logged_out_landing_page", "label": "Logged-out landing page", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L200", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real kit build in its own shell; kit files kept out of STATIC_ASSETS; manifest start_url becomes /auth/login so app launches skip the marketing page; claims limited to what the repo proves."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_service_worker_cache_bump", "label": "Service worker cache bump", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bump cache names and CACHE_VERSION and version changed CSS/JS URLs with ?v= so phones never keep old CSS after deploy."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_fake_data_preview_server", "label": "Fake-data preview server", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L265", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dev-only script starting the real app with mocked Mongo and seeded data; the team's MongoDB is never written to."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_standalone_wrapper_removal", "label": "standalone wrapper removal", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L314", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Toga WebView wrapper and its six CI workflows were removed because the PWA already covers install, offline and push."}, {"id": "docs_superpowers_specs_2026_11_10_castle_redesign_design_pin_unversioned_cdn_scripts_recommended", "label": "Pin unversioned CDN scripts (recommended)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": "L259", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Out of scope but recommended next: localforage from jsdelivr @master is render-blocking and Canvas.js throws if it fails at a venue; sortablejs@latest and unpinned chart.js too."}], "edges": [{"source": "docs_superpowers_specs_2026_11_10_castle_redesign_design", "target": "docs_superpowers_specs_2026_11_10_castle_redesign_design_team_334_techknights", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_10_castle_redesign_design", "target": "docs_superpowers_specs_2026_11_10_castle_redesign_design_banner_light_theme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_10_castle_redesign_design", "target": "docs_superpowers_specs_2026_11_10_castle_redesign_design_night_watch_dark_theme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_10_castle_redesign_design", "target": "docs_superpowers_specs_2026_11_10_castle_redesign_design_approach_c_rebuild_every_page_on_the_kit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_10_castle_redesign_design", "target": "docs_superpowers_specs_2026_11_10_castle_redesign_design_hook_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-10-castle-redesign-design.md", "source_loc